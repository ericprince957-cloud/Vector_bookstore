# BookVault - Environment Variables
# Copy this file to .env and fill in your values

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api

# Paystack Public Key (NEVER use secret key in frontend)
# Get this from your Paystack dashboard: https://dashboard.paystack.com/#/settings/developer
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site URL (used for SEO canonical URLs and OG tags)
VITE_SITE_URL=https://bookvault.ng

# Site Name (used in meta tags)
VITE_SITE_NAME=BookVault
